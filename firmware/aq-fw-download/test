# 全局配置 
port: 7890
allow-lan: true
bind-address: "*"
ipv6: false
log-level: warning
mode: rule

profile:
  store-selected: true
  store-fake-ip: true

# DNS模块
dns:
  enable: true
  ipv6: false
  respect-rules: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: blacklist
  fake-ip-filter:
#    - "geosite:private,cn"
#    - "rule-set:private_domain,cn_domain"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "time.*.com"
  default-nameserver:
    - 223.5.5.5
  proxy-server-nameserver:
    - https://223.5.5.5/dns-query

# namesever最好用运营商提供的DNS
  nameserver:
    - 223.5.5.5
    - 119.29.29.29
 
# 出站策略
proxy-groups: 
  - name: wifi1
    type: select
    include-all: true
    filter: "(?=.*(①))"

  - name: wifi2
    type: select
    include-all: true
    filter: "(?=.*(②))"

  - name: wifi3
    type: select
    include-all: true
    filter: "(?=.*(③))"

  - name: wifi4
    type: select
    include-all: true
    filter: "(?=.*(④))"

  - name: wifi5
    type: select
    include-all: true
    filter: "(?=.*(⑤))"

  - name: wifi6
    type: select
    include-all: true
    filter: "(?=.*(⑥))"

  - name: wifi7
    type: select
    include-all: true
    filter: "(?=.*(⑦))"

  - name: wifi8
    type: select
    include-all: true
    filter: "(?=.*(⑧))"

  - name: wifi9
    type: select
    include-all: true
    filter: "(?=.*(⑨))"

  - name: wifi10
    type: select
    include-all: true
    filter: "(?=.*(⑩))"

  - name: wifi11
    type: select
    include-all: true
    filter: "(?=.*(⑪))"

  - name: wifi12
    type: select
    include-all: true
    filter: "(?=.*(⑫))"


  - name: 🌐 全部节点
    type: select
    include-all: true
    filter: "^(?!.*(刷新|机场|官网|回国|以下|移动|联通|电信)).*$"

rules:
  - SRC-IP-CIDR,10.20.1.0/24,wifi1
  - SRC-IP-CIDR,10.20.2.0/24,wifi2
  - SRC-IP-CIDR,10.20.3.0/24,wifi3
  - SRC-IP-CIDR,10.20.4.0/24,wifi4
  - SRC-IP-CIDR,10.20.5.0/24,wifi5
  - SRC-IP-CIDR,10.20.6.0/24,wifi6
  - SRC-IP-CIDR,10.20.7.0/24,wifi7
  - SRC-IP-CIDR,10.20.8.0/24,wifi8
  - SRC-IP-CIDR,10.20.9.0/24,wifi9
  - SRC-IP-CIDR,10.20.10.0/24,wifi10
  - SRC-IP-CIDR,10.20.11.0/24,wifi11
  - SRC-IP-CIDR,10.20.12.0/24,wifi12
  
  - GEOSITE,private,DIRECT
  - GEOSITE,cn,DIRECT
  - GEOIP,private,DIRECT,no-resolve
  - GEOIP,cn,DIRECT,no-resolve
  - MATCH,🌐 全部节点

# 规则集
rule-anchor:
  ip: &ip {type: http, interval: 86400, behavior: ipcidr, format: mrs}
  domain: &domain {type: http, interval: 86400, behavior: domain, format: mrs}
  class: &class {type: http, interval: 86400, behavior: classical, format: text}
rule-providers: 
  private_domain: { <<: *domain, url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/private.mrs"}
  cn_domain: { <<: *domain, url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/cn.mrs"}
  cn_ip: { <<: *ip, url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/cn.mrs"}
